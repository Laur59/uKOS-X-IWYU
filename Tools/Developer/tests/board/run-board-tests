"""Run console tests against a flashed uKOS-X board.

The host suite (Tools/Developer/bin/run-tests) proves a CLI module's logic with
no hardware. This proves that the firmware on a real board still behaves, which
is a different question: roughly half the error strings in these modules need a
manager to fail and are unreachable here, a module's exit status is invisible
because the console collapses success and failure into the same break, and the
values - timestamps, addresses, uptimes, the VCS# - all move between builds.
Every assertion is therefore about the SHAPE of the output, unless a
placeholder pins it to the variant under test.

The tests are one spec per CLI module (cli/<module>.json), and the CLIs to
run are the ones the variant's CMakeLists.txt compiles. Each CLI the variant
declares must also be registered on the board, or the firmware was not built
from this tree.

This never opens the serial port itself and never starts a session: re-opening
the device toggles DTR, which resets some targets. Start one with
`ukos-serial start --port ...` first.

Exit codes match ukos-serial: 0 all passed, 1 error, 2 the board went
unreachable mid-run, 3 at least one assertion failed.
"""

import argparse
import json
import os
import sys

sys.path.insert(0, os.path.dirname(os.path.realpath(__file__)))

from ukos_board import (KSERIAL, KSPECS, Refusal, describe,  # noqa: E402
                        identify, only_session, prepare, send_row,
                        skip_reason)

RED = GREEN = YELLOW = BOLD = DIM = NC = ""


def colours(enable):
    global RED, GREEN, YELLOW, BOLD, DIM, NC
    if enable:
        RED, GREEN, YELLOW = "\033[0;31m", "\033[0;32m", "\033[0;33m"
        BOLD, DIM, NC = "\033[1m", "\033[2m", "\033[0m"


def main():
    ap = argparse.ArgumentParser(
        prog="run-board-tests",
        description="Run the per-CLI console specs against a flashed "
                    "uKOS-X board.")
    ap.add_argument("--name", help="ukos-serial session name")
    ap.add_argument("--variant", metavar="DIR",
                    help="variant directory (default: the one the board "
                         "names in its 'uKOS' answer)")
    ap.add_argument("--specs", metavar="DIR", default=KSPECS,
                    help="per-CLI spec directory (default: %(default)s)")
    ap.add_argument("--expect-sha", metavar="SHA",
                    help="pin ${VCS} to this firmware revision instead of "
                         "its shape")
    ap.add_argument("-t", "--filter", help="only ids containing this substring")
    ap.add_argument("-l", "--list", action="store_true",
                    help="list the test ids and exit")
    ap.add_argument("-n", "--dry-run", action="store_true",
                    help="print what would be sent, send nothing")
    ap.add_argument("--have", action="append", default=[], metavar="TAG",
                    help="declare an available hw: tag; repeatable")
    ap.add_argument("--allow-unsafe", action="store_true",
                    help="run rows that need ukos-serial's --unsafe")
    ap.add_argument("--allow-poison", action="store_true",
                    help="run rows that leave the board changed until reset "
                         "(they run last)")
    ap.add_argument("-v", "--verbose", action="store_true",
                    help="print the capture for every row, not only failures")
    ap.add_argument("--json", action="store_true")
    ap.add_argument("--stop-on-fail", action="store_true")
    args = ap.parse_args()

    colours(sys.stdout.isatty() and os.environ.get("NO_COLOR") is None)

    if not os.path.exists(KSERIAL):
        sys.stderr.write("error: ukos-serial not found next to this script\n")
        return 1

    try:
        return run(args)
    except Refusal as exc:
        sys.stderr.write("error: %s\n" % exc)
        return 1


def run(args):
    offline = args.list or args.dry_run

    # --list and --dry-run must work with no board attached, so the tests have
    # to be resolvable without asking the hardware what it is.
    ident, modules = {}, {}
    if not offline:
        # The rows read the session log by name, so the fallback ukos-serial
        # applies without --name has to be made here: a None name crashed the
        # first row instead of running it.
        if not args.name:
            args.name = only_session()
            if args.name is None:
                sys.stderr.write("error: no single ukos-serial session; start "
                                 "one, or pick one with --name\n")
                return 1
        rc, ident, modules = identify(args.name)
        if rc == 2:
            sys.stderr.write("error: the board did not answer 'uKOS' / 'list'\n")
            return 2

    ctx = prepare(ident, modules, args.variant, args.specs, args.expect_sha)
    variant, facts, tests = ctx["variant"], ctx["facts"], ctx["tests"]
    uncovered, inventory, extra = ctx["uncovered"], ctx["inventory"], ctx["extra"]

    if args.list:
        for test in tests:
            print(test["id"])
        return 0

    print("%sBoard%s" % (BOLD, NC))
    if ident:
        print("  board      %s" % " / ".join(
            ident.get(k, "?") for k in ("Board", "Variant", "SoC", "Core")))
        print("  firmware   VCS# %s" % ident.get("VCS#", "?"))
    print("  variant    %s" % os.path.relpath(variant["path"]))
    print("  expects    %s / %s  (%d CLIs)"
          % (facts["SOC"], facts["CORE"], len(variant["clis"])))
    print("  specs      %s  (%d tests)" % (os.path.relpath(args.specs), len(tests)))

    passed = failed = skipped = 0
    results = []

    print("\n%sInventory%s" % (BOLD, NC))
    for cli, present in inventory:
        if present:
            continue
        failed += 1
        results.append({"id": "inventory/" + cli, "result": "fail"})
        print("  %sFAIL%s  %-34s declared by the variant, not registered "
              "on the board" % (RED, NC, "inventory/" + cli))
    if inventory and all(present for _, present in inventory):
        print("  %sok%s    all %d CLIs of the variant are registered"
              % (GREEN, NC, len(inventory)))
    for cli in extra:
        print("  %swarn%s  %-34s registered on the board, not declared "
              "by the variant" % (YELLOW, NC, "inventory/" + cli))
    covered = len(variant["clis"]) - len(uncovered)
    print("  %scover%s %d/%d CLIs have a spec; none for: %s"
          % (DIM, NC, covered, len(variant["clis"]),
             ", ".join(uncovered) or "-"))

    print("\n%sRun%s" % (BOLD, NC))

    for test in tests:
        tid = test["id"]
        if args.filter and (args.filter not in tid):
            continue

        skip = skip_reason(test, modules, args.have, args.allow_unsafe,
                           offline, args.allow_poison)

        if skip:
            skipped += 1
            results.append({"id": tid, "result": "skip", "reason": skip})
            print("  %sSKIP%s  %-34s %s" % (YELLOW, NC, tid, skip))
            continue

        if args.dry_run:
            print("  %ssend%s  %-34s %s" % (DIM, NC, tid, test["cmd"]))
            if args.verbose:
                for pattern in test.get("expect", []):
                    print("          expect %s" % pattern)
                for pattern in test.get("refute", []):
                    print("          refute %s" % pattern)
            for step in test.get("then", []):
                if "send" in step:
                    print("        then send  %s" % step["send"])
                elif "write" in step:
                    print("        then write %s" % step["write"])
                elif "absent" in step:
                    print("        then absent %s" % step["absent"])
                else:
                    print("        then await %s" % step["await"])
                if args.verbose:
                    for pattern in step.get("expect", []):
                        print("          expect %s" % pattern)
                    for pattern in step.get("refute", []):
                        print("          refute %s" % pattern)
            continue

        rc, rep = send_row(test, args.name)

        if rc == 2:
            # The prompt never came back; every later verdict would be noise.
            print("  %sFAIL%s  %-34s board unreachable (timeout)"
                  % (RED, NC, tid))
            print("\n%sAborting: the session is in an unknown state.%s"
                  % (RED, NC))
            return 2

        if rc == 0:
            passed += 1
            results.append({"id": tid, "result": "pass"})
            if args.verbose:
                print("  %sok%s    %-34s" % (GREEN, NC, tid))
                print(indent(rep.get("text", "")))
            continue

        failed += 1
        results.append({"id": tid, "result": "fail",
                        "failures": rep.get("failures", []),
                        "error": rep.get("error")})
        print("  %sFAIL%s  %s" % (RED, NC, tid))
        for failure in rep.get("failures", []):
            print("          %s" % describe(failure))
        if rep.get("error"):
            print("          %s" % rep["error"])
        if test.get("note"):
            print("          %snote: %s%s" % (DIM, test["note"], NC))
        print("          board said:")
        print(indent(rep.get("text", "")))
        if args.stop_on_fail:
            break

    if args.dry_run:
        print("\ndry run: nothing was sent")
        return 0

    print("\n%d passed, %d failed, %d skipped" % (passed, failed, skipped))
    if args.json:
        print(json.dumps({"pass": failed == 0, "board": ident,
                          "results": results, "uncovered": uncovered},
                         indent=2))
    return 3 if failed else 0


def indent(text):
    lines = [l for l in text.replace("\r\n", "\n").split("\n") if l.strip()]
    return "\n".join("            " + l for l in lines[:12]) or "            (nothing)"


if __name__ == "__main__":
    sys.exit(main())
