{
  "app": "m_MicroPythons/fibonacci",
  "note": "Starts MicroPython with a script that prints the Fibonacci series below 1000 in a loop.",
  "tests": [
    {
      "id": "m_MicroPythons/fibonacci/runs-the-script",
