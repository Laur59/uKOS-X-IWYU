# Make a camera application on this Mac stream from a uKOS-X board.

"""Select a board as the video source of Quick Camera (macOS).

A board with the cdc_video profile shows up on the host as a USB camera, and
the viewer sends pictures only while an application is streaming from it. A
reset of the board ends that: the camera leaves the bus, the application falls
back on another one and does not come back by itself. This picks the board
again in Camera > Select Source, which is what a row that needs a streaming
host (hw:video-host) wants done just before it runs:

    board-regression --board <Board> --allow-unsafe \\
        --have video-host=Tools/Developer/bin/select-video-source

It drives the menu through System Events, so the terminal needs the
Accessibility permission (System Settings > Privacy & Security). It never
starts the application: one that opens on the camera of the Mac would show
whoever sits in front of it, so starting it is left to the user.

Exit code 0 when the source is selected and the window says so, 1 otherwise.
"""

import argparse
import subprocess
import sys
import time

KAPPLICATION = "Quick Camera"
KSOURCE      = "uKOS-X Control"


def osascript(script):
    done = subprocess.run(["osascript", "-e", script],
                          capture_output=True, text=True)
    return done.returncode, done.stdout.strip(), done.stderr.strip()


def tell(application, what):
    return osascript('tell application "System Events" to tell process "%s" '
                     'to %s' % (application, what))


def sources(application):
    """{name: ticked} of Camera > Select Source, or an error string."""

    menu = ('menu 1 of menu item "Select Source" of menu 1 of '
            'menu bar item "Camera" of menu bar 1')
    rc, names, err = tell(application, "get name of every menu item of " + menu)
    if rc != 0:
        return err or "no answer from System Events"
    rc, marks, err = tell(application, 'get value of attribute '
                          '"AXMenuItemMarkChar" of every menu item of ' + menu)
    if rc != 0:
        return err or "no answer from System Events"
    names = [n.strip() for n in names.split(",")]
    marks = [m.strip() for m in marks.split(",")]
    return {n: (m not in ("", "missing value")) for n, m in zip(names, marks)}


def main():
    ap = argparse.ArgumentParser(description=__doc__.split("\n")[0])
    ap.add_argument("--application", default=KAPPLICATION,
                    help="camera application (default: %(default)s)")
    ap.add_argument("--source", default=KSOURCE,
                    help="name of the board in Select Source "
                         "(default: %(default)s)")
    ap.add_argument("--timeout", type=float, default=20.0,
                    help="seconds to wait for the board to be on the bus "
                         "again (default: %(default)s)")
    ap.add_argument("--settle", type=float, default=2.0,
                    help="seconds left to the stream to start "
                         "(default: %(default)s)")
    args = ap.parse_args()

    if sys.platform != "darwin":
        sys.stderr.write("error: this drives a macOS application\n")
        return 1

    # The board needs a few seconds after a reset before the host lists its
    # camera again; the application then has the entry in its menu.
    deadline = time.time() + args.timeout
    seen = "nothing"
    while True:
        found = sources(args.application)
        if isinstance(found, dict) and args.source in found:
            break
        seen = found if isinstance(found, str) else \
            "sources: " + ", ".join(found)
        if time.time() >= deadline:
            sys.stderr.write("error: '%s' is not a source of %s (%s)\n"
                             % (args.source, args.application, seen))
            return 1
        time.sleep(1.0)

    if not found[args.source]:
        rc, _, err = tell(args.application,
                          'click menu item "%s" of menu 1 of menu item '
                          '"Select Source" of menu 1 of menu bar item '
                          '"Camera" of menu bar 1' % args.source)
        if rc != 0:
            sys.stderr.write("error: cannot select '%s': %s\n"
                             % (args.source, err))
            return 1

    # Believe the application, not the click: the tick and the window title.
    deadline = time.time() + 5.0
    while True:
        found = sources(args.application)
        rc, title, _ = tell(args.application, "get name of window 1")
        if rc != 0:
            # No window to show the stream in (closed, or the application is
            # hidden): the source may be ticked, nothing is streaming.
            title = "none on screen"
        if isinstance(found, dict) and found.get(args.source) \
                and (args.source in title):
            break
        if time.time() >= deadline:
            sys.stderr.write("error: %s did not switch to '%s' (window: %s)\n"
                             % (args.application, args.source, title))
            return 1
        time.sleep(0.5)

    time.sleep(args.settle)
    print("%s streams from '%s'" % (args.application, args.source))
    return 0


if __name__ == "__main__":
    sys.exit(main())
