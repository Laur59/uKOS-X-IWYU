{
  "version": 10,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 31,
    "patch": 0
  },

  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "generator": "Ninja",
      "binaryDir": "build",
      "cacheVariables": {
        "USER_MODE": "ON",
        "CANARY": "ON",
        "C_LIBRARY": "newlib",
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON"
      }
    },
    {
      "name": "gcc",
      "inherits": "base",
      "displayName": "GCC   · newlib",
      "description": "GNU GCC toolchain, newlib (default C library), user mode ON, stack protection ON",
      "cacheVariables": {
        "USE_LLVM": "OFF"
      }
    },
    {
      "name": "llvm",
      "inherits": "base",
      "displayName": "Clang · newlib",
      "description": "LLVM Clang toolchain, newlib (default C library), user mode ON, stack protection ON",
      "cacheVariables": {
        "USE_LLVM": "ON"
      }
    },
    {
      "name": "gcc-picolibc",
      "inherits": "gcc",
      "displayName": "GCC   · picolibc",
      "description": "GNU GCC toolchain, picolibc",
      "cacheVariables": { "C_LIBRARY": "picolibc" }
    },
    {
      "name": "llvm-picolibc",
      "inherits": "llvm",
      "displayName": "Clang · picolibc",
      "description": "LLVM Clang toolchain, picolibc",
      "cacheVariables": { "C_LIBRARY": "picolibc" }
    },
    {
      "name": "llvm-llvmlibc",
      "inherits": "llvm",
      "displayName": "Clang · llvm-libc",
      "description": "LLVM Clang toolchain, LLVM libc",
      "cacheVariables": {
        "C_LIBRARY": "llvmlibc"
      }
    }
  ],

  "buildPresets": [
    { "name": "gcc",           "configurePreset": "gcc" },
    { "name": "gcc-picolibc",  "configurePreset": "gcc-picolibc" },
    { "name": "llvm",          "configurePreset": "llvm" },
    { "name": "llvm-picolibc", "configurePreset": "llvm-picolibc" },
    { "name": "llvm-llvmlibc", "configurePreset": "llvm-llvmlibc" }
  ],

  "workflowPresets": [
    {
      "name": "llvm",
      "displayName": "Clang · newlib",
      "steps": [
        { "type": "configure", "name": "llvm" },
        { "type": "build",     "name": "llvm" }
      ]
    },
    {
      "name": "llvm-picolibc",
      "displayName": "Clang · picolibc",
      "steps": [
        { "type": "configure", "name": "llvm-picolibc" },
        { "type": "build",     "name": "llvm-picolibc" }
      ]
    },
    {
      "name": "llvm-llvmlibc",
      "displayName": "Clang · llvm-libc",
      "steps": [
        { "type": "configure", "name": "llvm-llvmlibc" },
        { "type": "build",     "name": "llvm-llvmlibc" }
      ]
    },
    {
      "name": "gcc",
      "displayName": "GCC   · newlib",
      "steps": [
        { "type": "configure", "name": "gcc" },
        { "type": "build",     "name": "gcc" }
      ]
    },
    {
      "name": "gcc-picolibc",
      "displayName": "GCC   · picolibc",
      "steps": [
        { "type": "configure", "name": "gcc-picolibc" },
        { "type": "build",     "name": "gcc-picolibc" }
      ]
    }
  ]
}
