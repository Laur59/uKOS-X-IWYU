#include    <stdint.h>

#include    "kern/kern.h"
#include    "os_errors.h"
#include    "sdcard/sdcard.h"       // IWYU pragma: keep (for symbol sdcard_specification_t)

// Definitions for the SDC commands

#define KCMD0_GO_IDLE_STATE             0U                              // GO_IDLE_STATE
#define KSEND_OP_COND_MMC               1U                              // KSEND_OP_COND_MMC
#define KCMD2_ALL_SEND_CID              2U                              // KCMD2_ALL_SEND_CID
#define KCMD3_SEND_REL_ADDR             3U                              // KCMD3_SEND_REL_ADDR
#define KACMD6_SET_BUS_WIDTH            6U                              // KACMD6_SET_BUS_WIDTH
#define KCMD7_SELECT_CARD               7U                              // KCMD7_SELECT_CARD
#define KCMD8_SEND_IF_COND              8U                              // KCMD8_SEND_IF_COND
#define KCMD9_SEND_CSD                  9U                              // KCMD9_SEND_CSD
#define KCMD10_SEND_CID                 10U                             // KCMD10_SEND_CID
#define KCMD12_STOP_TRANSMISSION        12U                             // KCMD12_STOP_TRANSMISSION
#define KCMD13_SEND_STATUS              13U                             // KCMD13_SEND_STATUS
#define KCMD16_SET_BLOCKLEN             16U                             // KCMD16_SET_BLOCKLEN
#define KCMD17_READ_SINGLE_BLOCK        17U                             // KCMD17_READ_SINGLE_BLOCK
#define KCMD18_READ_MULTIPLE_BLOCK      18U                             // KCMD18_READ_MULTIPLE_BLOCK
#define KCMD24_WRITE_BLOCK              24U                             // KCMD24_WRITE_BLOCK
#define KCMD25_WRITE_MULTIPLE_BLOCK     25U                             // KCMD25_WRITE_MULTIPLE_BLOCK
#define KACMD41_SD_SEND_OP_COND         41U                             // KACMD41_SD_SEND_OP_COND
#define KCMD55_APP_CMD                  55U                             // KCMD55_APP_CMD
#define KCMD58_SEND_OCR                 58U                             // KCMD58_SEND_OCR

#define SDMMC_RESP_NONE                 0U                              // NO response
#define SDMMC_RESP_SHORT                1U                              // Short response
#define SDMMC_RESP_LONG                 3U                              // Long response

#define SDMMC_TIMEOUT                   1000000U                        // 1s timeout

// Prototypes

static  bool    local_readBlock(uint8_t *destination, uint32_t sector);
static  bool    local_readSector(uint8_t *destination, uint32_t size);
static  bool    local_writeBlock(const uint8_t *source, uint32_t sector);
static  bool    local_writeSector(const uint8_t *source, uint32_t size);
static  void    local_clockSpeed(uint32_t speed);
static  bool    local_writeCommand(uint32_t command, uint32_t argument, uint32_t response);
static  bool    local_commandReady(void);
static  bool    local_readCSD(uint8_t csd[16]);
static  bool    local_readCID(uint8_t cid[16]);

static  sdcard_specification_t  vSdCard;
static  uint32_t                vRca;

/*
 * \brief model_sdcard_init
 *
 * - Initialise some specific parts
 *
 */
int32_t model_sdcard_init(void) {

    cb_control(KSDCARD_INIT);
    return KERR_STORAGE_NOERR;
}

/*
 * \brief model_sdcard_readStatus
 *
 * - Read the status of the card (only if it is inserted)
 *
 */
int32_t model_sdcard_readStatus(void) {
    int32_t     status;

    #ifdef WITH_SD_INSERTED_S
    status = (cb_cardInserted() == true)    ? (KERR_STORAGE_NOERR) : (KERR_STORAGE_NODEV);

    #else
    status = KERR_STORAGE_NOERR;
    #endif

    return status;
}

/*
 * \brief model_sdcard_initialise
 *
 * - Initialise the SDMCC sdcard
 *   - Waiting for > than 1-ms after the power-on
 *   - Place the interface in a slow mode (< 400-KHz) and disable the sdcard
 *   - Send the KGO_IDLE_STATE (software reset)
 *     - if R1 == 0x01u OK, else, unknown sdcard
 *
 *   - Send the KSEND_IF_COND (Check the voltage range)
 *     - if R1 == 0x01u       OK, else, unknown sdcard
 *     - if R7 == 0x000001AAu OK, else, unknown sdcard
 *
 *   - Send the KSEND_OP_COND_SDC(0x40000000u) (sdcard initialisation process)
 *     - if R1 == 0x00u OK, else, waiting under timeout, then, unknown sdcard
 *
 *   - Send the KREAD_OCR (Read the ocr)
 *     - if R1 == 0x01u sdcard V 2.0 (Block address)
 *     - if R1 == 0x00u sdcard V 2.0 (Byte address)
 *
 */
int32_t model_sdcard_initialise(sdcard_specification_t *specification) {
    int32_t     status;
    uint8_t     i, csd[16], cid[16];
    uint32_t    ocr, speed;

    vSdCard = (sdcard_specification_t){ 0 };

    status = model_sdcard_readStatus();
    if (status != KERR_STORAGE_NOERR) { return status; }

// Waiting for > than 1-ms after the power-on

    local_clockSpeed(400000U);
    kern_suspendProcess(5U);

// CMD0: Reset card, enter Idle state
// CMD8: Check voltage range and SD version

    if (!local_writeCommand(KCMD0_GO_IDLE_STATE, 0U, SDMMC_RESP_NONE))                           { return KERR_STORAGE_CANRE; }
    if (!local_writeCommand(KCMD8_SEND_IF_COND, 0x000001AAU, SDMMC_RESP_SHORT))                  { return KERR_STORAGE_CANRE; }
    if ((SDMMC->RESP1R & 0xFFFU) != 0x1AAU)                                                      { return KERR_STORAGE_CANRE; }

// ACMD41: Start card initialization process

    for (i = 0U; i < 200U; i++) {
        if (!local_writeCommand(KCMD55_APP_CMD, 0U, SDMMC_RESP_SHORT))                          { return KERR_STORAGE_CANRE; }
        if (!local_writeCommand(KACMD41_SD_SEND_OP_COND, 0x40300000U, SDMMC_RESP_SHORT))        { return KERR_STORAGE_CANRE; }

        ocr = SDMMC->RESP1R;
        if ((ocr & 0x80000000U) != 0U) { break; }
        kern_suspendProcess(1U);
    }
    if ((ocr & 0x80000000U) == 0U)                                                               { return KERR_STORAGE_CANRE; }

    specification->oCapacityStatus = ((ocr & 0x40000000U) != 0U) ? ((uint8_t)KSDCARD_CT_SD2 | (uint8_t)KSDCARD_CT_BLOCK) : ((uint8_t)KSDCARD_CT_SD2);

// CMD2:  Read CID register
// CMD3:  Get Relative Card Address (RCA)
// CMD9:  Read CSD register
// CMD7:  Select card via RCA (0xFFFF0000u)
// ACMD6: Set bus width of 4-bit bus
// CMD16: Set block length = 512

    if (!local_writeCommand(KCMD2_ALL_SEND_CID, 0U, SDMMC_RESP_LONG))                            { return KERR_STORAGE_CANRE; }
    if (!local_writeCommand(KCMD3_SEND_REL_ADDR, 0U, SDMMC_RESP_SHORT))                          { return KERR_STORAGE_CANRE; }
    vRca = SDMMC->RESP1R & 0xFFFF0000U;

    if (!local_readCSD(csd))                                                                     { return KERR_STORAGE_CANRE; }
    if (!local_readCID(cid))                                                                     { return KERR_STORAGE_CANRE; }
    if (!local_writeCommand(KCMD7_SELECT_CARD, vRca, SDMMC_RESP_SHORT))                          { return KERR_STORAGE_CANRE; }
    if (!local_writeCommand(KCMD55_APP_CMD, vRca, SDMMC_RESP_SHORT))                             { return KERR_STORAGE_CANRE; }
    if (!local_writeCommand(KACMD6_SET_BUS_WIDTH, 2U, SDMMC_RESP_SHORT))                         { return KERR_STORAGE_CANRE; }
    SDMMC->CLKCR &= ~SDMMC_CLKCR_WIDBUS;
    SDMMC->CLKCR |=  (1U * SDMMC_CLKCR_WIDBUS_0);

    if (!local_writeCommand(KCMD16_SET_BLOCKLEN, KSDCARD_SZ_SECTOR, SDMMC_RESP_SHORT))           { return KERR_STORAGE_CANRE; }

// Extract "Product name"
// Extract "Manufacturer"
// Extract "Serial number"

    for (i = 0U; i < 5U; i++) { specification->oProductName[i] = cid[3U + i]; }
    specification->oProductName[5] = 0;
    specification->oManufacturer   = cid[0];
    specification->oSerialNumber   = (((uint32_t)cid[8]<<24U)
                                   |  ((uint32_t)cid[9]<<16U)
                                   |  ((uint32_t)cid[10]<<8U)
                                   |  ((uint32_t)cid[11]));

// Extract "Voltage"
// Extract "Device size"
// Extract "Speed"

    specification->oVoltage = (uint16_t)((ocr>>15) & 0x1FFU);
    specification->oSize    = (uint64_t)(((((uint32_t)(csd[7] & 0x3FU)<<16U)
                            |               ((uint32_t)csd[8]<<8U)
                            |               ((uint32_t)csd[9])) + 1LLU) * 512LLU * 1024LLU);

    switch (csd[3] & 0x07U) {
        case 0x0U: { speed = 100000U;           break; }
        case 0x1U: { speed = 1000000U;          break; }
        case 0x2U: { speed = 10000000U;         break; }
        case 0x3U: { speed = 100000000U;        break; }
        default:   { speed = 100000U;           break; }
    }
    switch ((csd[3] & 0xF8U)>>3U) {
        case 0x1U: { speed = speed * 10U / 10U; break; }
        case 0x2U: { speed = speed * 12U / 10U; break; }
        case 0x3U: { speed = speed * 13U / 10U; break; }
        case 0x4U: { speed = speed * 15U / 10U; break; }
        case 0x5U: { speed = speed * 20U / 10U; break; }
        case 0x6U: { speed = speed * 25U / 10U; break; }
        case 0x7U: { speed = speed * 30U / 10U; break; }
        case 0x8U: { speed = speed * 35U / 10U; break; }
        case 0x9U: { speed = speed * 40U / 10U; break; }
        case 0xAU: { speed = speed * 45U / 10U; break; }
        case 0xBU: { speed = speed * 50U / 10U; break; }
        case 0xCU: { speed = speed * 55U / 10U; break; }
        case 0xDU: { speed = speed * 60U / 10U; break; }
        case 0xEU: { speed = speed * 70U / 10U; break; }
        case 0xFU: { speed = speed * 80U / 10U; break; }
        default:   { speed = speed * 10U / 10U; break; }
    }
    specification->oSpeed = speed;

// Extract "Product name"

    for (i = 0U; i <  5U; i++) { specification->oProductName[i] = cid[3U + i]; }
    specification->oProductName[5] = 0U;

// Activate the high-speed clock

    local_clockSpeed(speed);
    vSdCard = *specification;
    return KERR_STORAGE_NOERR;
}

/*
 * \brief model_sdcard_read
 *
 * - Read from the sdcard 1 or more sectors
 *
 */
int32_t model_sdcard_read(const sdcard_specification_t *specification, uint8_t *buffer, uint8_t nbSectors, uint32_t sector) {
    int32_t     status;
    uint8_t     i;
    bool        error = false;

    status = model_sdcard_readStatus();
    if (status != KERR_STORAGE_NOERR) { return status;             }
    if (nbSectors == 0U)              { return KERR_STORAGE_LNBU0; }

    local_clockSpeed(specification->oSpeed);

    for (i = 0U; i < nbSectors; i++) {
        if (!local_readBlock(&buffer[(uint32_t)i * KSDCARD_SZ_SECTOR], sector + i)) {
            error = true;
            break;
        }
    }

    return (error ? KERR_STORAGE_TRANT : KERR_STORAGE_NOERR);
}

/*
 * \brief model_sdcard_write
 *
 * - Write on the sdcard 1 or more sectors
 *
 */
int32_t model_sdcard_write(const sdcard_specification_t *specification, const uint8_t *buffer, uint8_t nbSectors, uint32_t sector) {
    int32_t     status;
    uint8_t     i;
    bool        error = false;

    status = model_sdcard_readStatus();
    if (status != KERR_STORAGE_NOERR) { return status;             }
    if (nbSectors == 0U)              { return KERR_STORAGE_LNBU0; }

    local_clockSpeed(specification->oSpeed);

    for (i = 0U; i < nbSectors; i++) {
        if (!local_writeBlock(&buffer[(uint32_t)i * KSDCARD_SZ_SECTOR], sector + i)) {
            error = true;
            break;
        }
    }

    return (error ? KERR_STORAGE_TRANT : KERR_STORAGE_NOERR);
}

/*
 * \brief model_sdcard_ioctl
 *
 * - Read some card parameters
 *
 */
int32_t model_sdcard_ioctl(storageIoctl_t command, void *buffer) {

    switch (command) {
        case KGET_BLOCK_SIZE: {
            *(uint32_t *)buffer = 1U;
            break;
        }
        case KGET_SECTOR_SIZE: {
            *(uint16_t *)buffer = KSDCARD_SZ_SECTOR;
            break;
        }
        case KGET_SECTOR_COUNT: {
            *(uint32_t *)buffer = (uint32_t)(vSdCard.oSize / KSDCARD_SZ_SECTOR);
            break;
        }
        default: {

// Make MISRA happy :-)

            break;
        }
    }
    return KERR_STORAGE_NOERR;
}

// Local routines
// ==============

/*
 * \brief local_readBlock
 *
 * - Read data block
 *
 */
static  bool    local_readBlock(uint8_t *destination, uint32_t sector) {

    if (!local_commandReady()) {
        return false;
    }

    SDMMC->DTIMER = 0xFFFFFFFFU;
    SDMMC->DLENR  = KSDCARD_SZ_SECTOR;
    SDMMC->DCTRL  = (9U * SDMMC_DCTRL_DBLOCKSIZE_0) | SDMMC_DCTRL_DTDIR | SDMMC_DCTRL_DTEN;

    if (!local_writeCommand(KCMD17_READ_SINGLE_BLOCK, sector, SDMMC_RESP_SHORT)) {
        return false;
    }

    return (local_readSector(destination, KSDCARD_SZ_SECTOR));
}

/*
 * \brief local_readSector
 *
 * - Read data
 *
 */
static  bool    local_readSector(uint8_t *destination, uint32_t size) {
    uint64_t    time[2];
    uint32_t    data, i, words;

    words = size / 4U;

    kern_readTickCount(&time[0]);
    while (words > 0U) {
        if ((SDMMC->STAR & SDMMC_STAR_RXFIFOHF) != 0U) {
            for (i = 0U; (i < 8U) && (words > 0U); i++) {
                data = SDMMC->FIFOR;

                *destination++ = (uint8_t)(data>>0U);
                *destination++ = (uint8_t)(data>>8U);
                *destination++ = (uint8_t)(data>>16U);
                *destination++ = (uint8_t)(data>>24U);
                words--;
            }
        }

        if ((SDMMC->STAR & (SDMMC_STAR_DTIMEOUT | SDMMC_STAR_DCRCFAIL | SDMMC_STAR_RXOVERR)) != 0U) {
            SDMMC->ICR = 0xFFFFFFFFU;
            return false;
        }

        kern_switchFast();
        kern_readTickCount(&time[1]);
        if ((time[1] - time[0]) >= SDMMC_TIMEOUT) { SDMMC->ICR = 0xFFFFFFFFU; return false; }

    }

    kern_readTickCount(&time[0]);
    while ((SDMMC->STAR & SDMMC_STAR_DATAEND) == 0U) {
        if ((SDMMC->STAR & (SDMMC_STAR_DTIMEOUT | SDMMC_STAR_DCRCFAIL | SDMMC_STAR_RXOVERR)) != 0U) {
            SDMMC->ICR = 0xFFFFFFFFU;
            return false;
        }

        kern_switchFast();
        kern_readTickCount(&time[1]);
        if ((time[1] - time[0]) >= SDMMC_TIMEOUT) { SDMMC->ICR = 0xFFFFFFFFU; return false; }
    }

    SDMMC->ICR = 0xFFFFFFFFU;
    return true;
}

/*
 * \brief local_writeBlock
 *
 * - Write data block
 *
 */
static  bool    local_writeBlock(const uint8_t *source, uint32_t sector) {

    if (!local_commandReady()) {
        return false;
    }

    SDMMC->DTIMER = 0xFFFFFFFFU;
    SDMMC->DLENR  = KSDCARD_SZ_SECTOR;
    SDMMC->DCTRL  = (9U * SDMMC_DCTRL_DBLOCKSIZE_0) | SDMMC_DCTRL_DTEN;

    if (!local_writeCommand(KCMD24_WRITE_BLOCK, sector, SDMMC_RESP_SHORT)) {
        return false;
    }

    return (local_writeSector(source, KSDCARD_SZ_SECTOR));
}

/*
 * \brief local_writeSector
 *
 * - Write data
 *
 */
static  bool    local_writeSector(const uint8_t *source, uint32_t size) {
    uint64_t    time[2];
    uint32_t    i, data, words;

    words = size / 4U;

    kern_readTickCount(&time[0]);
    while (words > 0U) {
        if ((SDMMC->STAR & SDMMC_STAR_TXFIFOHE) != 0U) {
            for (i = 0U; (i < 8U) && (words > 0U); i++) {
                data = ((uint32_t)source[0]<<0U)
                     | ((uint32_t)source[1]<<8U)
                     | ((uint32_t)source[2]<<16U)
                     | ((uint32_t)source[3]<<24U);

                SDMMC->FIFOR = data;
                source += 4U;
                words--;
            }
        }

        if ((SDMMC->STAR & (SDMMC_STAR_DTIMEOUT | SDMMC_STAR_DCRCFAIL | SDMMC_STAR_TXUNDERR)) != 0U) {
            SDMMC->ICR = 0xFFFFFFFFU;
            return false;
        }

        kern_switchFast();
        kern_readTickCount(&time[1]);
        if ((time[1] - time[0]) >= SDMMC_TIMEOUT) { SDMMC->ICR = 0xFFFFFFFFU; return false; }

    }

    kern_readTickCount(&time[0]);
    while ((SDMMC->STAR & SDMMC_STAR_DATAEND) == 0U) {
        if ((SDMMC->STAR & (SDMMC_STAR_DTIMEOUT | SDMMC_STAR_DCRCFAIL | SDMMC_STAR_TXUNDERR)) != 0U) {
            SDMMC->ICR = 0xFFFFFFFFU;
            return false;
        }

        kern_switchFast();
        kern_readTickCount(&time[1]);
        if ((time[1] - time[0]) >= SDMMC_TIMEOUT) { SDMMC->ICR = 0xFFFFFFFFU; return false; }
    }

    SDMMC->ICR = 0xFFFFFFFFU;
    return true;
}

/*
 * \brief local_clockSpeed
 *
 */
static  void    local_clockSpeed(uint32_t speed) {
    uint32_t    sdmmcKernelClock = SDMMC_FREQUENCY;
    uint32_t    wideBus = SDMMC->CLKCR & SDMMC_CLKCR_WIDBUS;
    uint32_t    div = (sdmmcKernelClock + ((2U * speed) - 1U)) / (2U * speed);

    if (div == 0U)    { div = 1U;     }
    if (div > 0x3FFU) { div = 0x3FFU; }

// Power-off
// Set the clock to xxx-MHz

    SDMMC->POWER = 0U;
    SDMMC->CLKCR = 0U;
    SDMMC->CLKCR = (div * SDMMC_CLKCR_CLKDIV_0)
                 | SDMMC_CLKCR_HWFC_EN
                 | wideBus;

// Power-on

    SDMMC->POWER = (3U * SDMMC_POWER_PWRCTRL_0);
}

/*
 * \brief local_writeCommand
 *
 */
static  bool    local_writeCommand(uint32_t command, uint32_t argument, uint32_t response) {
    uint64_t    time[2];

    SDMMC->ICR  = 0xFFFFFFFFU;
    SDMMC->ARGR = argument;
    SDMMC->CMDR = (command & 0x3FU)
                | (response * SDMMC_CMDR_WAITRESP_0)
                | SDMMC_CMDR_CPSMEN;

    kern_readTickCount(&time[0]);
    while ((SDMMC->STAR & (SDMMC_STAR_CTIMEOUT | SDMMC_STAR_CCRCFAIL | SDMMC_STAR_CMDREND | SDMMC_STAR_CMDSENT)) == 0U) {
        kern_switchFast();
        kern_readTickCount(&time[1]);
        if ((time[1] - time[0]) >= SDMMC_TIMEOUT)                                                                               { SDMMC->ICR = 0xFFFFFFFFU; return false; }
    }

// CMD0 has no response
// R3/R7 may not use CRC the same way; ignore CCRCFAIL for ACMD41

    if ((response == SDMMC_RESP_NONE) && ((SDMMC->STAR & SDMMC_STAR_CMDSENT) != 0U))                                            { SDMMC->ICR = 0xFFFFFFFFU; return true;  }
    if ((SDMMC->STAR & SDMMC_STAR_CTIMEOUT) != 0U)                                                                              { SDMMC->ICR = 0xFFFFFFFFU; return false; }
    if ((command != KACMD41_SD_SEND_OP_COND) && (command != KCMD8_SEND_IF_COND) && ((SDMMC->STAR & SDMMC_STAR_CCRCFAIL) != 0U)) { SDMMC->ICR = 0xFFFFFFFFU; return false; }

    SDMMC->ICR = 0xFFFFFFFFU;
    return true;
}

/*
 * \brief local_commandReady
 *
 */
static  bool    local_commandReady(void) {
    uint32_t    status;
    uint64_t    time[2];

    kern_readTickCount(&time[0]);
    do {
        if (!local_writeCommand(KCMD13_SEND_STATUS, vRca, SDMMC_RESP_SHORT))    { return false; }

        status = SDMMC->RESP1R;
        if (((status & 0x00000100U) != 0U) && (((status>>9U) & 0x0FU) == 4U))   { return true;  }

        kern_switchFast();
        kern_readTickCount(&time[1]);
    } while ((time[1] - time[0]) < SDMMC_TIMEOUT);
    return false;
}

/*
 * \brief local_readCSD
 *
 */
static  bool    local_readCSD(uint8_t csd[16]) {
    uint32_t    r[4];

    if (!local_writeCommand(KCMD9_SEND_CSD, vRca, SDMMC_RESP_LONG)) {
        return false;
    }

    r[0] = SDMMC->RESP1R;
    r[1] = SDMMC->RESP2R;
    r[2] = SDMMC->RESP3R;
    r[3] = SDMMC->RESP4R;

    for (uint8_t i = 0U; i < 4U; i++) {
        csd[(i * 4U) + 0U] = (uint8_t)(r[i]>>24U);
        csd[(i * 4U) + 1U] = (uint8_t)(r[i]>>16U);
        csd[(i * 4U) + 2U] = (uint8_t)(r[i]>>8U);
        csd[(i * 4U) + 3U] = (uint8_t)(r[i]);
    }
    return true;
}

/*
 * \brief local_readCID
 *
 */
static  bool    local_readCID(uint8_t cid[16]) {
    uint32_t    r[4];

    if (!local_writeCommand(KCMD10_SEND_CID, vRca, SDMMC_RESP_LONG)) {
        return false;
    }

    r[0] = SDMMC->RESP1R;
    r[1] = SDMMC->RESP2R;
    r[2] = SDMMC->RESP3R;
    r[3] = SDMMC->RESP4R;

    for (uint8_t i = 0U; i < 4U; i++) {
        cid[(i * 4U) + 0U] = (uint8_t)(r[i]>>24U);
        cid[(i * 4U) + 1U] = (uint8_t)(r[i]>>16U);
        cid[(i * 4U) + 2U] = (uint8_t)(r[i]>>8U);
        cid[(i * 4U) + 3U] = (uint8_t)(r[i]);
    }
    return true;
}
