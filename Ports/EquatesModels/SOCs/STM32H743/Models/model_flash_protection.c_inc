 *
 * Goal:     Model for controlling the "flash" protection.
 */

#undef  ALLOW_L2_S

/*
 * \brief model_flash_protect
 *
 * - Protect the flash from reading
 *   The used protection could be: level 0, level 1 and level 2
 *   !!! the flash cannot be reprogrammed anymore in level 2 !!!
 *
 */
void    model_flash_protect(uint8_t level) {
    uint32_t    optprg;

    INTERRUPTION_OFF;

// Allow operations on the Flash

    FLASH->OPTKEYR = 0x08192A3BU;
    FLASH->OPTKEYR = 0x4C5D6E7FU;

    if ((FLASH->OPTCR & FLASH_OPTCR_OPTLOCK) == 0U) {

// Set the selected level 0, 1 or 2

        optprg = FLASH->OPTSR_PRG;
        optprg &= (uint32_t)~(0xFFU<<8U);

        switch (level) {
            case 0x00U: { optprg |= (0xAAU<<8U); break; }
            case 0x01U: { optprg |= (0x55U<<8U); break; }

            #if (defined(ALLOW_L2_S))
            case 0x02U: { optprg |= (0xCCU<<8U); break; }
            #endif

            default:   { optprg |= (0xAAU<<8U); break; }
        }

        FLASH->OPTSR_PRG = optprg;

// Validate the choice

        FLASH->OPTCR |= FLASH_OPTCR_OPTSTART;

        while ((FLASH->OPTSR_CUR & FLASH_OPTSR_CUR_OPT_BUSY) != 0U) { ; }

        FLASH->OPTCR |= FLASH_OPTCR_OPTLOCK;
    }

    INTERRUPTION_RESTORE;
}
