/*
 * SPDX-License-Identifier: MIT
 * SPDX-FileCopyrightText: 2025-2026 Edo. Franzi
 *
 * Goal:    Model for controlling the "qspi" device.
 *
 *          Validated device:
 *              C8 40 18  GigaDevice GD25Q128 compatible
 *
 *          Compatible target:
 *              EF 40 18  Winbond W25Q128 compatible
 *
 *          Operational mode:
 *              - WREN / status / erase: 1-bit SPI commands through QUADSPI
 *              - Program: Quad Input Page Program 0x32
 *              - Read: Fast Read Quad I/O 0xEB
 *
 *          Important STM32 QUADSPI note:
 *              For transactions with address phase, configure CCR first, then write AR.
 *
 * Composition: this fragment is a template; the including .c must define:
 *   BFLASH_xSPI_BUSY BFLASH_xSPI_QE BFLASH_xSPI_WEL KFLASH_QSPI_CMD_READ
 *   KFLASH_QSPI_CMD_READ_STATUS KFLASH_QSPI_CMD_WRITE KFLASH_QSPI_CMD_WRITE_STATUS
 *   KFLASH_xSPI_CMD_ERASE_SECTOR KFLASH_xSPI_CMD_READ_STATUS
 *   KFLASH_xSPI_CMD_WRITE_ENABLE KFLASH_xSPI_NB_SECTOR KFLASH_xSPI_SZ_FLASH
 *   KFLASH_xSPI_SZ_PAGE KFLASH_xSPI_SZ_SECTOR KQSPI_FREQUENCY KQSPI_READ_CHUNK
 *   KQSPI_SPEED QSPI cb_enable
 */

#include    <stdint.h>

#include    "clockTree.h"
#include    "kern/kern.h"
#include    "os_errors.h"
#include    "soc_reg.h"
#include    "storage/storage.h"

#define KFLASH_SPI_READ_DUMMY_CYCLES    4u

// Prototypes

static  void    local_flash_qspi_write(const uint8_t *buffer, uint32_t size, uint32_t sector);
static  void    local_flash_qspi_read(uint8_t *buffer, uint32_t size, uint32_t sector);
static  void    local_flash_qspi_erase(uint32_t size, uint32_t sector);
static  void    local_flash_qspi_wait_ready(void);
static  void    local_flash_qspi_quad_enable(void);
static  void    local_flash_qspi_write_enable(void);
static  void    local_flash_qspi_command(uint8_t cmd);
static  void    local_flash_qspi_read_U8(uint8_t cmd, uint8_t *value);
static  void    local_flash_qspi_write_U8(uint8_t cmd, uint8_t value);

/*
 * \brief model_flash_qspi_init
 *
 * - Initialise some specific parts
 *
 */
int32_t model_flash_qspi_init(void) {

    return KERR_STORAGE_NOERR;
}

/*
 * \brief model_flash_qspi_initialise
 *
 * - Initialise the flash
 *
 */
int32_t model_flash_qspi_initialise(void) {
    uint32_t    prescaler, size, log = 0U;

    cb_enable();

// Compute the log_2 of the size

    size = KFLASH_xSPI_SZ_FLASH;
    do { log++; size = size>>1U; } while (size != 1U);

// Initialise the QSPI

    prescaler = KQSPI_FREQUENCY / KQSPI_SPEED;

    if (prescaler != 0U)  { prescaler--;      }
    if (prescaler > 255U) { prescaler = 255U; }

    QSPI->CR  = 0U;
    QSPI->FCR = QUADSPI_FCR_CTEF | QUADSPI_FCR_CTCF | QUADSPI_FCR_CSMF | QUADSPI_FCR_CTOF;
    QSPI->DCR = ((log - 1U) * QUADSPI_DCR_FSIZE_0)
              | (1U * QUADSPI_DCR_CSHT_0);

    QSPI->CR  = (prescaler * QUADSPI_CR_PRESCALER_0)
              | (0U * QUADSPI_CR_FTHRES_0)
              | QUADSPI_CR_EN;

    local_flash_qspi_quad_enable();
    return KERR_STORAGE_NOERR;
}

/*
 * \brief model_flash_qspi_readStatus
 *
 * - Read the status of the card (only inserted)
 *
 */
int32_t model_flash_qspi_readStatus(void) {

    return KERR_STORAGE_NOERR;
}

/*
 * \brief model_flash_qspi_read
 *
 * - Read from the flash 1 or more sectors
 *
 */
int32_t model_flash_qspi_read(uint8_t *buffer, uint32_t size, uint32_t sector) {

    local_flash_qspi_read(buffer, size, sector);
    return KERR_STORAGE_NOERR;
}

/*
 * \brief model_flash_qspi_write
 *
 * - Write to the flash 1 or more sectors
 *
 */
int32_t model_flash_qspi_write(const uint8_t *buffer, uint32_t size, uint32_t sector) {

    local_flash_qspi_write(buffer, size, sector);
    return KERR_STORAGE_NOERR;
}

/*
 * \brief model_flash_qspi_ioctl
 *
 * - Read some flash parameters
 *
 */
int32_t model_flash_qspi_ioctl(storageIoctl_t command, void *buffer) {

    switch (command) {
        case KGET_BLOCK_SIZE: {
            *(uint32_t *)buffer = 1U;
            break;
        }
        case KGET_SECTOR_SIZE: {
            *(uint16_t *)buffer = KFLASH_xSPI_SZ_SECTOR;
            break;
        }
        case KGET_SECTOR_COUNT: {
            *(uint32_t *)buffer = KFLASH_xSPI_NB_SECTOR;
            break;
        }
        default: {

// Make MISRA happy :-)

            break;
        }
    }
    return KERR_STORAGE_NOERR;
}

// Local routines
// ==============

/*
 * \brief local_flash_qspi_read
 *
 * - Read
 *
 */
static  void    local_flash_qspi_read(uint8_t *buffer, uint32_t size, uint32_t sector) {
    uint32_t    i, address, chunk, remaining;
    uint8_t     *wkBuffer = buffer;

    address   = sector * KFLASH_xSPI_SZ_SECTOR;
    remaining = size;

    while (remaining > 0) {
        chunk = remaining;
        chunk = (chunk > KQSPI_READ_CHUNK) ? (KQSPI_READ_CHUNK) : chunk;

        while ((QSPI->SR & QUADSPI_SR_BUSY) != 0U) { kern_switchFast(); }

// Fast Read Quad I/O 0xEB:
// instruction on 1 line, address on 4 lines,
// alternate byte on 4 lines, data on 4 lines

        QSPI->FCR = QUADSPI_FCR_CTEF | QUADSPI_FCR_CTCF | QUADSPI_FCR_CSMF | QUADSPI_FCR_CTOF;
        QSPI->DLR = chunk - 1U;
        QSPI->ABR = 0xFFU;
        QSPI->CCR = (KFLASH_QSPI_CMD_READ * QUADSPI_CCR_INSTRUCTION_0)
                  | (1U * QUADSPI_CCR_IMODE_0)
                  | (3U * QUADSPI_CCR_ADMODE_0)
                  | (2U * QUADSPI_CCR_ADSIZE_0)
                  | (3U * QUADSPI_CCR_ABMODE_0)
                  | (0U * QUADSPI_CCR_ABSIZE_0)
                  | (3U * QUADSPI_CCR_DMODE_0)
                  | (KFLASH_SPI_READ_DUMMY_CYCLES * QUADSPI_CCR_DCYC_0)
                  | (1U * QUADSPI_CCR_FMODE_0);

        QSPI->AR = address;

        for (i = 0U; i < chunk; i++) {
            while ((QSPI->SR & QUADSPI_SR_FLEVEL) == 0U) { kern_switchFast(); }

            *wkBuffer++ = *((volatile uint8_t *)&QSPI->DR);
        }
        while ((QSPI->SR & QUADSPI_SR_TCF) == 0U) { kern_switchFast(); }

        QSPI->FCR = QUADSPI_FCR_CTEF | QUADSPI_FCR_CTCF | QUADSPI_FCR_CSMF | QUADSPI_FCR_CTOF;
        address   += chunk;
        remaining -= chunk;
    }
}

/*
 * \brief local_flash_qspi_write
 *
 * - Program a page
 *
 */
static  void    local_flash_qspi_write(const uint8_t *buffer, uint32_t size, uint32_t sector) {
            uint32_t    i, address, chunk, remaining;
    const   uint8_t     *wkBuffer = buffer;

    address   = sector * KFLASH_xSPI_SZ_SECTOR;
    remaining = size;

    local_flash_qspi_erase(size, sector);

    while (remaining > 0) {
        chunk = remaining;
        chunk = (chunk > KFLASH_xSPI_SZ_PAGE) ? (KFLASH_xSPI_SZ_PAGE) : chunk;

// Write complete pages of 256-bytes
// In case of the page is not complete,
// the page is completed with dummy data

        local_flash_qspi_write_enable();

        while ((QSPI->SR & QUADSPI_SR_BUSY) != 0U) { kern_switchFast(); }

// Quad Input Page Program 0x32:
// instruction on 1 line, address on 1 line, data on 4 lines

        QSPI->FCR = QUADSPI_FCR_CTEF | QUADSPI_FCR_CTCF | QUADSPI_FCR_CSMF | QUADSPI_FCR_CTOF;
        QSPI->DLR = chunk - 1U;
        QSPI->CCR = (KFLASH_QSPI_CMD_WRITE * QUADSPI_CCR_INSTRUCTION_0)
                  | (1U * QUADSPI_CCR_IMODE_0)
                  | (1U * QUADSPI_CCR_ADMODE_0)
                  | (2U * QUADSPI_CCR_ADSIZE_0)
                  | (3U * QUADSPI_CCR_DMODE_0)
                  | (0U * QUADSPI_CCR_FMODE_0);

        QSPI->AR = address;

        for (i = 0U; i < chunk; i++) {
            while ((QSPI->SR & QUADSPI_SR_FTF) == 0U) { kern_switchFast(); }

            *((volatile uint8_t *)&QSPI->DR) = *wkBuffer++;
        }

        while ((QSPI->SR & QUADSPI_SR_TCF) == 0U) { kern_switchFast(); }
        address   += chunk;
        remaining -= chunk;

        QSPI->FCR = QUADSPI_FCR_CTEF | QUADSPI_FCR_CTCF | QUADSPI_FCR_CSMF | QUADSPI_FCR_CTOF;
        local_flash_qspi_wait_ready();
    }
}

/*
 * \brief local_flash_qspi_erase
 *
 * - Erase a sector
 *
 */
static  void    local_flash_qspi_erase(uint32_t size, uint32_t sector) {
    uint32_t    nbSectors, address;

    address   = sector * KFLASH_xSPI_SZ_SECTOR;
    nbSectors = (size + KFLASH_xSPI_SZ_SECTOR - 1U) / KFLASH_xSPI_SZ_SECTOR;

    for (sector = 0U; sector < nbSectors; sector++) {
        local_flash_qspi_write_enable();
        while ((QSPI->SR & QUADSPI_SR_BUSY) != 0U) { kern_switchFast(); }

// Configure CCR first, then write AR to launch the address phase

        QSPI->FCR = QUADSPI_FCR_CTEF | QUADSPI_FCR_CTCF | QUADSPI_FCR_CSMF | QUADSPI_FCR_CTOF;
        QSPI->CCR = (KFLASH_xSPI_CMD_ERASE_SECTOR * QUADSPI_CCR_INSTRUCTION_0)
                  | (1U * QUADSPI_CCR_IMODE_0)
                  | (1U * QUADSPI_CCR_ADMODE_0)
                  | (2U * QUADSPI_CCR_ADSIZE_0)
                  | (0U * QUADSPI_CCR_DMODE_0)
                  | (0U * QUADSPI_CCR_FMODE_0);

        QSPI->AR = address;

        while ((QSPI->SR & QUADSPI_SR_TCF) == 0U) { kern_switchFast(); }
        address += KFLASH_xSPI_SZ_SECTOR;

        QSPI->FCR = QUADSPI_FCR_CTEF | QUADSPI_FCR_CTCF | QUADSPI_FCR_CSMF | QUADSPI_FCR_CTOF;
        local_flash_qspi_wait_ready();
    }
}

/*
 * \brief local_flash_qspi_command
 *
 * - Send a commande
 *
 */
static  void    local_flash_qspi_command(uint8_t cmd) {

    while ((QSPI->SR & QUADSPI_SR_BUSY) != 0U) { kern_switchFast(); }

    QSPI->FCR = QUADSPI_FCR_CTEF | QUADSPI_FCR_CTCF | QUADSPI_FCR_CSMF | QUADSPI_FCR_CTOF;
    QSPI->CCR = ((uint32_t)cmd * QUADSPI_CCR_INSTRUCTION_0)
              | (1U * QUADSPI_CCR_IMODE_0)
              | (0U * QUADSPI_CCR_ADMODE_0)
              | (0U * QUADSPI_CCR_DMODE_0)
              | (0U * QUADSPI_CCR_FMODE_0);

    while ((QSPI->SR & QUADSPI_SR_TCF) == 0U) { kern_switchFast(); }

    QSPI->FCR = QUADSPI_FCR_CTEF | QUADSPI_FCR_CTCF | QUADSPI_FCR_CSMF | QUADSPI_FCR_CTOF;
}

/*
 * \brief local_flash_qspi_read_U8
 *
 * - Read a uint8_t
 *
 */
static  void    local_flash_qspi_read_U8(uint8_t cmd, uint8_t *value) {

    while ((QSPI->SR & QUADSPI_SR_BUSY) != 0U) { kern_switchFast(); }

    QSPI->FCR = QUADSPI_FCR_CTEF | QUADSPI_FCR_CTCF | QUADSPI_FCR_CSMF | QUADSPI_FCR_CTOF;
    QSPI->DLR = 0U;
    QSPI->CCR = ((uint32_t)cmd * QUADSPI_CCR_INSTRUCTION_0)
              | (1U * QUADSPI_CCR_IMODE_0)
              | (0U * QUADSPI_CCR_ADMODE_0)
              | (1U * QUADSPI_CCR_DMODE_0)
              | (1U * QUADSPI_CCR_FMODE_0);

    while ((QSPI->SR & QUADSPI_SR_FLEVEL) == 0U) { kern_switchFast(); }
    *value = *((volatile uint8_t *)&QSPI->DR);

    while ((QSPI->SR & QUADSPI_SR_TCF) == 0U) { kern_switchFast(); }
    QSPI->FCR = QUADSPI_FCR_CTEF | QUADSPI_FCR_CTCF | QUADSPI_FCR_CSMF | QUADSPI_FCR_CTOF;
}

/*
 * \brief local_flash_qspi_write_U8
 *
 * - Write a uint8_t
 *
 */
static  void    local_flash_qspi_write_U8(uint8_t cmd, uint8_t value) {

    while ((QSPI->SR & QUADSPI_SR_BUSY) != 0U) { kern_switchFast(); }

    QSPI->FCR = QUADSPI_FCR_CTEF | QUADSPI_FCR_CTCF | QUADSPI_FCR_CSMF | QUADSPI_FCR_CTOF;
    QSPI->DLR = 0U;
    QSPI->CCR = ((uint32_t)cmd * QUADSPI_CCR_INSTRUCTION_0)
              | (1U * QUADSPI_CCR_IMODE_0)
              | (0U * QUADSPI_CCR_ADMODE_0)
              | (1U * QUADSPI_CCR_DMODE_0)
              | (0U * QUADSPI_CCR_FMODE_0);

    *((volatile uint8_t *)&QSPI->DR) = value;

    while ((QSPI->SR & QUADSPI_SR_TCF) == 0U) { kern_switchFast(); }
    QSPI->FCR = QUADSPI_FCR_CTEF | QUADSPI_FCR_CTCF | QUADSPI_FCR_CSMF | QUADSPI_FCR_CTOF;
}

/*
 * \brief local_flash_qspi_wait_ready
 *
 * - Waiting for Flash ready
 *
 */
static  void    local_flash_qspi_wait_ready(void) {
    uint8_t     sr1;

    do {
        local_flash_qspi_read_U8(KFLASH_xSPI_CMD_READ_STATUS, &sr1);
        if ((sr1 & (1U<<BFLASH_xSPI_BUSY)) == 0U) {
            return;
        }
        kern_suspendProcess(1U);
    } while (true);
}

/*
 * \brief local_flash_qspi_write_enable
 *
 * - Write enable
 *
 */
static  void    local_flash_qspi_write_enable(void) {
    uint8_t     sr1;

    local_flash_qspi_command(KFLASH_xSPI_CMD_WRITE_ENABLE);

    do {
        local_flash_qspi_read_U8(KFLASH_xSPI_CMD_READ_STATUS, &sr1);
        if ((sr1 & (1U<<BFLASH_xSPI_WEL)) != 0U) {
            return;
        }

        kern_switchFast();
    } while (true);
}

/*
 * \brief local_flash_qspi_quad_enable
 *
 * - Enable the quad
 *
 */
static  void    local_flash_qspi_quad_enable(void) {
    uint8_t     sr2;

    local_flash_qspi_read_U8(KFLASH_QSPI_CMD_READ_STATUS, &sr2);
    sr2 |= (1U<<BFLASH_xSPI_QE);

    local_flash_qspi_write_enable();
    local_flash_qspi_write_U8(KFLASH_QSPI_CMD_WRITE_STATUS, sr2);
    local_flash_qspi_wait_ready();
}
