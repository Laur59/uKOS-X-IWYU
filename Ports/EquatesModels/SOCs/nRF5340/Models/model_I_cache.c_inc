#include    "macros_core.h"
#include    "soc_reg.h"

/*
 * \brief cache_I_Enable
 *
 * - Enable the instruction cache
 *
 */
static  inline  void    cache_I_Enable(void) {

// Enable I-Cache

    REG(NCACHE)->ENABLE = CACHE_ENABLE_ENABLE;
}
