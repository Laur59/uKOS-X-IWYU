 *
 * Goal:     Model for the core dump (SOC specific).
 *
 * Composition: included last by a board exce.c, after model_coreDump_generic.c_inc
 * (local_printFunction) and model_coreDump_core.c_inc (vStackBefore/After/CoreDump, vExceptionNb,
 * local_printCore, local_printStackFrame). The includer must provide cb_signal().
 *
 * The including .c must define:
 *   cb_signal local_printCore local_printFunction local_printStackFrame vExceptionNb vStackAfter vStackBefore vStackCoreDump
 */

#include    <stdint.h>

#include    "cmns.h"
#include    "core.h"
#include    "macros_core.h"
#include    "macros_core_stackFrame.h"
#include    "macros_soc.h"
#include    "record/private/private_recordDump.h"
#include    "serial/serial.h"
#include    "types.h"

// Prototypes

static  void    local_processInterruption(uintptr_t *stackBefore, uintptr_t *stackAfter);
static  void    local_printInterruption(const char_t **vectorName);

/*
 * \brief model_coreDump_displayInterruptions
 *
 *
 * Display useful postmortem information
 * Example:
 *
 * System dead! Core DUMP!!
 * ========================
 *
 * Exception: DMA1_Stream0_IRQn
 * Routine:   aProcess
 * Process:   Process_User_0
 *
 * User trace information
 *
 * Stacks contents before the fault
 * stack[+31] = 0x00000000
 * stack[+30] = 0x00000000
 * ...
 * stack[+01] = 0xBBB10001
 * stack[+00] = 0xAAA00000
 *
 * CPU registers: (PC after the fault instruction)
 * psp      = 0x730005A8    msp      = 0x3800FFF0
 * r00      = 0xAAA00000    r08      = 0xADA80008
 * r01      = 0xBBB10001    r09      = 0xAEA90009
 * r02      = 0xCCC20002    r10      = 0xAFAA000A
 * r03      = 0x001FFFFF    r11      = 0xBABB000B
 * r04      = 0x3800FFF0    r12      = 0xBBBC000C
 * r05      = 0xFFF50005    r13 (SP) = 0x73000540
 * r06      = 0xABA60006    r14      = 0x08018629
 * r07      = 0xACA70007    lr       = 0xFFFFFFED
 * xPSR     = 0x61000000    r15 (PC) = 0x7200020A
 * BASEPRI  = 0x00000070
 *
 * FPU registers
 * s00      = 0x3F800000    s16      = 0x41880000
 * s01      = 0x40000000    s17      = 0x41900000
 * s02      = 0x40400000    s18      = 0x41980000
 * s03      = 0x40800000    s19      = 0x41A00000
 * s04      = 0x40A00000    s20      = 0x41A80000
 * s05      = 0x40C00000    s21      = 0x41B00000
 * s06      = 0x40E00000    s22      = 0x41B80000
 * s07      = 0x41000000    s23      = 0x41C00000
 * s08      = 0x41100000    s24      = 0x41C80000
 * s09      = 0x41200000    s25      = 0x41D00000
 * s10      = 0x41300000    s26      = 0x41D80000
 * s11      = 0x41400000    s27      = 0x41E00000
 * s12      = 0x41500000    s28      = 0x41E80000
 * s13      = 0x41600000    s29      = 0x41F00000
 * s14      = 0x41700000    s30      = 0x41F80000
 * s15      = 0x41800000    s31      = 0xC1F80000
 * FPSCR    = 0x00000000
 *
 */
[[gnu::naked, noreturn]]
void    model_coreDump_displayInterruptions([[maybe_unused]] uintptr_t lr, [[maybe_unused]] uintptr_t *msp) {

    CORE_DUMP_SAVE_STACK_FRAME;

    JUMP_FNCT(local_processInterruption);
}

/*
 * \brief local_processInterruption
 *
 * - Collect the stack frame
 * - Display the interruption
 * - Display the fault routine & process
 * - Display the core information
 * - Display the user trace
 * - Display the stack frame
 *
 */
[[gnu::noinline, gnu::used, noreturn]]
static  void    local_processInterruption(uintptr_t *stackBefore, uintptr_t *stackAfter) {
            uint32_t    core, i;
    const   uintptr_t   *ptr;
    const   char_t      *vectorName;

    core = GET_RUNNING_CORE;

    vExceptionNb[core] = core_getIPSR();
    vStackBefore[core] = stackBefore;
    vStackAfter[core]  = stackAfter;

// Collect the stack frame

    ptr = vStackAfter[core];
    vStackCoreDump[core][SPP] = (uintptr_t)vStackAfter[core];
    for (i = PSP; i < ENDREG; i++) {
        vStackCoreDump[core][i] = *ptr;
        ptr++;
    }

    local_printInterruption(&vectorName);
    local_printFunction(vStackCoreDump[core][PC], vectorName, "Interruption: ");
    local_printCore();
    record_printTrace();
    record_printLog();
    local_printStackFrame();
    cb_signal(KINTERRUPTION);
}

/*
 * \brief local_printInterruption
 *
 * - Display the interruption name
 *
 */
[[gnu::noinline]]
static  void    local_printInterruption(const char_t **vectorName) {
    uint32_t    core;

    core = GET_RUNNING_CORE;

    cmns_send(KDEF0, "\n\n\n\n");
    cmns_send(KDEF0, "System dead! Core DUMP!!\n");
    cmns_send(KDEF0, "========================\n\n");
    switch (vExceptionNb[core]) {

        #ifdef CPU_APPLICATION_S
        case 0U:  { *vectorName = "FPU_IRQn";           break; }
        case 1U:  { *vectorName = "CACHE_IRQn";         break; }
        case 3U:  { *vectorName = "SPU_IRQn";           break; }
        case 5U:  { *vectorName = "CLOCK_POWER_IRQn";   break; }
        case 8U:  { *vectorName = "SERIAL0_IRQn";       break; }
        case 9U:  { *vectorName = "SERIAL1_IRQn";       break; }
        case 10U: { *vectorName = "SPIM4_IRQn";         break; }
        case 11U: { *vectorName = "SERIAL2_IRQn";       break; }
        case 12U: { *vectorName = "SERIAL3_IRQn";       break; }
        case 13U: { *vectorName = "GPIOTE0_IRQn";       break; }
        case 14U: { *vectorName = "SAADC_IRQn";         break; }
        case 15U: { *vectorName = "TIMER0_IRQn";        break; }
        case 16U: { *vectorName = "TIMER1_IRQn";        break; }
        case 17U: { *vectorName = "TIMER2_IRQn";        break; }
        case 20U: { *vectorName = "RTC0_IRQn";          break; }
        case 21U: { *vectorName = "RTC1_IRQn";          break; }
        case 24U: { *vectorName = "WDT0_IRQn";          break; }
        case 25U: { *vectorName = "WDT1_IRQn";          break; }
        case 26U: { *vectorName = "COMP_LPCOMP_IRQn";   break; }
        case 27U: { *vectorName = "EGU0_IRQn";          break; }
        case 28U: { *vectorName = "EGU1_IRQn";          break; }
        case 29U: { *vectorName = "EGU2_IRQn";          break; }
        case 30U: { *vectorName = "EGU3_IRQn";          break; }
        case 31U: { *vectorName = "EGU4_IRQn";          break; }
        case 32U: { *vectorName = "EGU5_IRQn";          break; }
        case 33U: { *vectorName = "PWM0_IRQn";          break; }
        case 34U: { *vectorName = "PWM1_IRQn";          break; }
        case 35U: { *vectorName = "PWM2_IRQn";          break; }
        case 36U: { *vectorName = "PWM3_IRQn";          break; }
        case 38U: { *vectorName = "PDM0_IRQn";          break; }
        case 40U: { *vectorName = "I2S0_IRQn";          break; }
        case 42U: { *vectorName = "IPC_IRQn";           break; }
        case 43U: { *vectorName = "QSPI_IRQn";          break; }
        case 45U: { *vectorName = "NFCT_IRQn";          break; }
        case 47U: { *vectorName = "GPIOTE1_IRQn";       break; }
        case 51U: { *vectorName = "QDEC0_IRQn";         break; }
        case 52U: { *vectorName = "QDEC1_IRQn";         break; }
        case 54U: { *vectorName = "USBD_IRQn";          break; }
        case 55U: { *vectorName = "USBREGULATOR_IRQn";  break; }
        case 57U: { *vectorName = "KMU_IRQn";           break; }
        case 68U: { *vectorName = "CRYPTOCELL_IRQn";    break; }
        default:  { *vectorName = "Unknown";            break; }

        #else
        case 5U:  { *vectorName = "CLOCK_POWER_IRQn";   break; }
        case 8U:  { *vectorName = "RADIO_IRQn";         break; }
        case 9U:  { *vectorName = "RNG_IRQn";           break; }
        case 10U: { *vectorName = "GPIOTE_IRQn";        break; }
        case 11U: { *vectorName = "WDT_IRQn";           break; }
        case 12U: { *vectorName = "TIMER0_IRQn";        break; }
        case 13U: { *vectorName = "ECB_IRQn";           break; }
        case 14U: { *vectorName = "AAR_CCM_IRQn";       break; }
        case 16U: { *vectorName = "TEMP_IRQn";          break; }
        case 17U: { *vectorName = "RTC0_IRQn";          break; }
        case 18U: { *vectorName = "IPC_IRQn";           break; }
        case 19U: { *vectorName = "SERIAL0_IRQn";       break; }
        case 20U: { *vectorName = "EGU0_IRQn";          break; }
        case 22U: { *vectorName = "RTC1_IRQn";          break; }
        case 24U: { *vectorName = "TIMER1_IRQn";        break; }
        case 25U: { *vectorName = "TIMER2_IRQn";        break; }
        case 26U: { *vectorName = "SWI0_IRQn";          break; }
        case 27U: { *vectorName = "SWI1_IRQn";          break; }
        case 28U: { *vectorName = "SWI2_IRQn";          break; }
        case 29U: { *vectorName = "SWI3_IRQn";          break; }
        default:  { *vectorName = "Unknown";            break; }
        #endif

    }
}
