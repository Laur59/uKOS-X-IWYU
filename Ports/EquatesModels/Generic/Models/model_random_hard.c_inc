 *
 * Fallback hardware random number generator model for SoCs without an RNG block:
 * KRANDOM_HARD is served by the soft generator.
 * Included by OS/Lib_cryptographics/random/random.c, which declares the model functions static.
 */

#include    <stdint.h>

#include    "random/random.h"

/*
 * \brief model_random_hard_init
 *
 * - Initialise the seed
 *
 */
static  void    model_random_hard_init(void) {

}

/*
 * \brief model_random_hard_read
 *
 * - Read a pseudo random number
 *
 */
static  void    model_random_hard_read(uint32_t *number) {

    model_random_soft_read(number);
}
