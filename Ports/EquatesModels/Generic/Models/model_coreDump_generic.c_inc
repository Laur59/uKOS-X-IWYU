#include    <stdint.h>

#include    "cmns.h"
#include    "kern/kern.h"
#include    "machine/machine.h"
#include    "macros_soc.h"
#include    "serial/serial.h"
#include    "types.h"

extern  proc_t  *vKern_runProc[KNB_CORES];

/*
 * \brief local_readFunctionName
 *
 * - Return the function name that belong to a given PC
 *
 */
void    local_readFunctionName(const uintptr_t pc, const char_t **function) {

    UNUSED(pc);

    #if ((uKOS_ARCHITECTURE == 0U) && (!defined(__clang__)))
            intptr_t    offset, nameLen;
    const   uintptr_t   *ptr;

    ptr = (const uintptr_t *)((pc + 2U) & (~0x3U));

    for (offset = 1; (offset < (intptr_t)(16U * 1024U)) && ((uintptr_t)&ptr[-offset] > (uintptr_t)0x0U); ++offset) {
        if ((ptr[-offset] & (uintptr_t)0xFFFFFF00U) == (uintptr_t)0xFF000000U) {
            nameLen = (intptr_t)(ptr[-offset] & (uintptr_t)0xFFU);
            *function = &((const char_t *)&ptr[-offset])[-nameLen];
            return;
        }

    }
    *function = nullptr;
    #endif

    *function = nullptr;
}

/*
 * \brief local_printFunction
 *
 * - Display the function name
 * - Display the process name
 *
 */
static  void    __attribute__ ((noinline)) local_printFunction(uintptr_t pc, const char_t *vectorName, const char_t *excepInter) {
            uint32_t    core;
    const   char_t      *functionName;

    core = GET_RUNNING_CORE;

    if (pc == 0U) {
        cmns_send(KDEF0, excepInter);       cmns_send(KDEF0, vectorName);   cmns_send(KDEF0, "\n");
    }
    else {
        local_readFunctionName(pc, &functionName);
        cmns_send(KDEF0, excepInter);       cmns_send(KDEF0, vectorName);   cmns_send(KDEF0, "\n");
        cmns_send(KDEF0, "Routine:      "); cmns_send(KDEF0, functionName); cmns_send(KDEF0, "\n");
    }

    #ifdef NO_KERNEL_S
    cmns_send(KDEF0, "No uKOS-X uKernel\n");

    #else
    cmns_send(KDEF0, "Process:      "); cmns_send(KDEF0, vKern_runProc[core]->oSpecification.oIdentifier); cmns_send(KDEF0, "\n");
    #endif
}
