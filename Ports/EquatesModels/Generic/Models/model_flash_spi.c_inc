 *
 * Goal:     Model for controlling the "flash" device by an SPI.
 */

#include    <stdint.h>

#include    "os_errors.h"
#include    "storage/storage.h"

// Prototypes

static  void    local_flash_spi_erase(uint32_t size, uint32_t sector);

/*
 * \brief model_flash_spi_init
 *
 * - Initialise some specific parts
 *
 */
int32_t model_flash_spi_init(void) {

    cb_control(KFLASH_INIT);
    return KERR_STORAGE_NOERR;
}

/*
 * \brief model_flash_spi_initialise
 *
 * - Initialise the flash
 *
 */
int32_t model_flash_spi_initialise(void) {

    return KERR_STORAGE_NOERR;
}

/*
 * \brief model_flash_spi_readStatus
 *
 * - Read the status of the card (only inserted)
 *
 */
int32_t model_flash_spi_readStatus(void) {

    return KERR_STORAGE_NOERR;
}

/*
 * \brief model_flash_spi_read
 *
 * - Read from the flash 1 or more sectors
 *
 */
int32_t model_flash_spi_read(uint8_t *buffer, uint32_t size, uint32_t sector) {
    uint8_t     *wkBuffer = buffer;
    uint32_t    address, index;

    if (size == 0U) {
        return KERR_STORAGE_NOERR;
    }

    cb_control(KFLASH_RESERVE_SPI);
    address = sector * KFLASH_xSPI_SZ_SECTOR;

// A read cycle 0x03U 0xAAu 0xAAu 0xAAu 0x00U
// 0x03U --> Read order
// 0xAAu --> 24-bit address

    kern_waitAtLeast(1);
    cb_control(KFLASH_SELECT);
    cb_writeRead(KFLASH_xSPI_CMD_READ);
    cb_writeRead((uint8_t)(address>>16U));
    cb_writeRead((uint8_t)(address>>8U));
    cb_writeRead((uint8_t)address);

    for (index = 0U; index < size; index++) {
        *wkBuffer = cb_writeRead(0x00U);
        wkBuffer++;
    }
    cb_control(KFLASH_DESELECT);
    cb_control(KFLASH_RELEASE_SPI);
    return KERR_STORAGE_NOERR;
}

/*
 * \brief model_flash_spi_write
 *
 * - Write pages
 * - This function writes pages. If a page is not complete
 *   this system call complete it with an unpredictable content
 *
 */
int32_t model_flash_spi_write(const uint8_t *buffer, uint32_t size, uint32_t sector) {
            uint32_t    address, index, pages, nbPages;
    const   uint8_t     *wkBuffer = buffer;

    if (size == 0U) {
        return KERR_STORAGE_NOERR;
    }

    cb_control(KFLASH_RESERVE_SPI);
    local_flash_spi_erase(size, sector);

    address = sector * KFLASH_xSPI_SZ_SECTOR;
    nbPages = (size + KFLASH_xSPI_SZ_PAGE - 1u) / KFLASH_xSPI_SZ_PAGE;

// Write complete pages of 256-bytes
// In case of the page is not complete,
// the page is completed with dummy data

    for (pages = 0U; pages < nbPages; pages++) {
        kern_waitAtLeast(1U);
        cb_control(KFLASH_SELECT);
        cb_writeRead(KFLASH_xSPI_CMD_WRITE_ENABLE);
        cb_control(KFLASH_DESELECT);

// Write a page 0x02U 0xAAu 0xAAu 0xAAu (256 x 0xDD) (waiting for 5-ms)
// 0x02U --> Write order
// 0xAAu --> 24-bit address (boundary of 256-bytes)
// 0xDDu --> 256 x Data

        kern_waitAtLeast(1);
        cb_control(KFLASH_SELECT);
        cb_writeRead(KFLASH_xSPI_CMD_WRITE);
        cb_writeRead((uint8_t)(address>>16U));
        cb_writeRead((uint8_t)(address>>8U));
        cb_writeRead((uint8_t)address);

        for (index = 0u; index < KFLASH_xSPI_SZ_PAGE; index++) {
            cb_writeRead(*wkBuffer);
            wkBuffer++;
        }
        cb_control(KFLASH_DESELECT);
        kern_suspendProcess(10U);
        address += KFLASH_xSPI_SZ_PAGE;
    }
    cb_control(KFLASH_RELEASE_SPI);
    return KERR_STORAGE_NOERR;
}

/*
 * \brief model_flash_spi_ioctl
 *
 * - Read some flash parameters
 *
 */
int32_t model_flash_spi_ioctl(storageIoctl_t command, void *buffer) {

    switch (command) {
        case KGET_BLOCK_SIZE: {
            *(uint32_t *)buffer = 1U;
            break;
        }
        case KGET_SECTOR_SIZE: {
            *(uint16_t *)buffer = KFLASH_xSPI_SZ_SECTOR;
            break;
        }
        case KGET_SECTOR_COUNT: {
            *(uint32_t *)buffer = KFLASH_xSPI_NB_SECTOR;
            break;
        }
        default: {

// Make MISRA happy :-)

            break;
        }
    }
    return KERR_STORAGE_NOERR;
}

// Local routines
// ==============

/*
 * \brief model_flash_spi_erase
 *
 * - Erase sectors
 *
 */
static  void    local_flash_spi_erase(uint32_t size, uint32_t sector) {
    uint32_t    nbSectors, address;

    address   = sector * KFLASH_xSPI_SZ_SECTOR;
    nbSectors = (size + KFLASH_xSPI_SZ_SECTOR - 1u) / KFLASH_xSPI_SZ_SECTOR;

    for (sector = 0U; sector < nbSectors; sector++) {
        kern_waitAtLeast(1U);
        cb_control(KFLASH_SELECT);
        cb_writeRead(KFLASH_xSPI_CMD_WRITE_ENABLE);
        cb_control(KFLASH_DESELECT);

// Erase a sector 4-KBytes
// 0x20U --> Sector erase order
// 0xAAu --> 24-bit address (boundary of 4-KBytes)

        kern_waitAtLeast(1U);
        cb_control(KFLASH_SELECT);
        cb_writeRead(KFLASH_xSPI_CMD_ERASE_SECTOR);
        cb_writeRead((uint8_t)(address>>16U));
        cb_writeRead((uint8_t)(address>>8U));
        cb_writeRead((uint8_t)address);
        cb_control(KFLASH_DESELECT);
        kern_suspendProcess(240U);
        address += KFLASH_xSPI_SZ_SECTOR;
    }
}
