/*
; link_p.
; =======

;------------------------------------------------------------------------
; Project: uKOS-X
;
; Purpose:
;    Linker description for the uKOS-X system.
;    Privileged only support
;
;                       CODE
; linker_stTEXT         +-----------------+
;                       |                 |
;                       | .isr_vector     |
;                       | .text           |
;                       | .rodata         |
; linker_enRODATA       |                 |
;                       +-----------------+
; linker_stSignature    |                 |             DATA
;                       +-----------------+ ........... +-----------------+ linker_stDATA
; linker_stINDATA       |                 |             |                 |
;                       | .data           |             | .data           |
;                       |                 |             |                 | linker_enDATA
;                       +-----------------+ ........... +-----------------+
;                                                       |                 | linker_stBSS
;                                                       | .bss            |
;                                                       | COMMON          |
;                                                       |                 | linker_enBSS
;                                                       +-----------------+
;------------------------------------------------------------------------
*/

ENTRY(Reset_C0_Handler)

INCLUDE     STM32L4R5xx.ld

/* Mapping:                                                 */
/*                                                          */
/* RAM1:    Stacks              0x20000000                  */
/*          6K                                              */
/*          Program Data        0x20001800                  */
/*          58K                                             */
/*          Heap                0x20010000                  */
/*          128K                                            */
/* RAM2:    Heap                0x20030000                  */
/*          64K                                             */
/* RAM3:    Heap                0x20040000                  */
/*          320K                                            */
/*          User Memory         0x20090000                  */
/*          64K                                             */

linker_sizeStackSystem_C0   = (4K);                                                     /* Length of the System stack                               */
linker_sizeStackFirst_C0    = (2K);                                                     /* Length of the First stack                                */
config_sizeData             = (58K);
config_sizeUserMemory       = (64K);
config_sizeHeap1            = stm_lnSRAM1 - config_sizeData - linker_sizeStackSystem_C0 - linker_sizeStackFirst_C0;
config_sizeHeap3            = stm_lnSRAM3 - config_sizeUserMemory;

/* IMPORTANT:                                               */
/* all the stacks have to be maintained aligned             */
/* on a boundary of 8-bytes                                 */

linker_lowStackFirst_C0     = stm_stSRAM1;                                              /* 0x20000000                                               */
linker_topStackFirst_C0     = linker_lowStackFirst_C0 + linker_sizeStackFirst_C0 - 8;
linker_lowStackSystem_C0    = linker_lowStackFirst_C0 + linker_sizeStackFirst_C0;       /* 0x20000800:                                              */
linker_topStackSystem_C0    = linker_lowStackSystem_C0 + linker_sizeStackSystem_C0 - 8;
ASSERT((linker_lowStackSystem_C0 & 7) == 0, "Stack system must be 8-byte aligned")
ASSERT((linker_topStackSystem_C0 & 7) == 0, "Stack system must be 8-byte aligned")
ASSERT((linker_lowStackFirst_C0 & 7)  == 0, "Stack user must be 8-byte aligned")
ASSERT((linker_topStackFirst_C0 & 7)  == 0, "Stack user must be 8-byte aligned")

/* IMPORTANT:                                               */
/* External memory, User (download application) and shared  */

linker_stEXRAM              = 0;                                                        /* 0x00000000: EXRAM, start of the external memory          */
linker_lnEXRAM              = (0);                                                      /* Length of the external memory                            */

linker_stUMemo              = (stm_stSRAM3 + config_sizeHeap3);                         /* 0x20090000: UMemo, start of the user memory              */
linker_lnUMemo              = config_sizeUserMemory;                                    /* 0x00010000: Length of the user memory                    */

/* IMPORTANT:                                               */
/* The heap has to be maintained aligned                    */
/* on a boundary of 8-bytes                                 */

linker_stHeap               = (linker_stPrgmData + linker_lnPrgmData);                  /* 0x20010000: start of the heap                            */
linker_lnHeap               = config_sizeHeap1 + stm_lnSRAM2 + config_sizeHeap3;        /* 0x00080000: Length of the heap                           */

/* IMPORTANT:                                               */
/* uKOS OS Flash + memory                                   */

linker_stPrgmCode           = stm_stINTFLASH;                                           /* 0x08000000: PrgmCode, start of the Flash                 */
linker_lnPrgmCode           = stm_lnINTFLASH;                                           /* 0x00100000: Length of the the Flash                      */

linker_stPrgmData           = linker_lowStackSystem_C0 + linker_sizeStackSystem_C0;     /* 0x20001800: start of program data                        */
linker_lnPrgmData           = config_sizeData;                                          /* 0x0000E800: Length of program data                       */

/* IMPORTANT:                                               */
/* equates necessary for the arm_v7 MPU regions             */
/* for the arm_v7 MPU the regions have to be 32-B aligned   */

linker_ST_FLASH_INT_0       = stm_stINTFLASH;                                           /* 0x08000000: Privileged/User FLASH                        */
linker_SZ_FLASH_INT_0       = 19;                                                       /* 1-M = 2^(SZ + 1), SZ = log2(1-M) - 1                     */

linker_ST_RAM_INT_0         = stm_stSRAM1;                                              /* 0x20000000: Privileged/User RAM                          */
linker_SZ_RAM_INT_0         = 19;                                                       /* 1-M = 2^(SZ + 1), SZ = log2(1-M) - 1                     */

MEMORY {
    prgm_code (rx)  : ORIGIN = linker_stPrgmCode, LENGTH = linker_lnPrgmCode
    prgm_data (rwx) : ORIGIN = linker_stPrgmData, LENGTH = linker_lnPrgmData
}

ASSERT((linker_sizeStackFirst_C0 + linker_sizeStackSystem_C0 + linker_lnPrgmData + linker_lnHeap + linker_lnUMemo) == stm_lnSRAM123, "Check RAM mapping: over/under usage")

INCLUDE     system_p.lld
